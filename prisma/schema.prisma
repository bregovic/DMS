// DMS – datový model
// Dokumentace: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) tabulky
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // pro přihlášení e-mailem/heslem (Credentials)
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  projects          Project[]  @relation("ProjectOwner")
  expensesCreated   Expense[]  @relation("ExpenseCreatedBy")
  documentsUploaded Document[] @relation("DocumentUploadedBy")
  vendors           Vendor[]     @relation("VendorOwner")
  requestsCreated   Request[]    @relation("RequestCreatedBy")
  subProjectsCreated SubProject[] @relation("SubProjectCreatedBy")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Doménový model
// ---------------------------------------------------------------------------

// Evidence dodavatelů v rámci účtu. E-mail je identifikátor (unikátní na účet)
// a bude sloužit i pro budoucí přístup dodavatele k dedikovaným projektům.
model Vendor {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  email       String
  category    String   @default("other")
  phone       String?
  description String?
  hourlyRate  Decimal? @db.Decimal(12, 2)
  bankAccount String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User      @relation("VendorOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  expenses Expense[]
  projects Project[] @relation("ProjectVendors")
  requests Request[]

  @@unique([ownerId, email])
  @@index([ownerId])
}

// Poptávka (procurement). Dodavatel může být prázdný – doplní se po výběru.
model Request {
  id           String    @id @default(cuid())
  projectId    String
  title        String
  description  String?
  quantity     Decimal?  @db.Decimal(12, 2)
  unit         String    @default("ks")
  category     String    @default("other")
  price        Decimal?  @db.Decimal(12, 2)
  vendorId     String?
  subProjectId String?
  requiredDate DateTime?
  status       String    @default("poptavka") // poptavka | nabidka | vyhovuje | schvaleno | zruseno
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor     Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  subProject SubProject? @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("RequestCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([vendorId])
  @@index([subProjectId])
}

// Sdílený číselník vlastních typů projektů (vestavěné typy jsou v kódu).
model ProjectType {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  icon      String   @default("folder")
  createdAt DateTime @default(now())
}

// Sdílený číselník vlastních kategorií výdajů (vestavěné jsou v kódu).
model ExpenseCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  createdAt DateTime @default(now())
}

// Sdílený číselník vlastních typů dokumentů (vestavěné jsou v kódu).
model DocumentType {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("other") // house, garage, car, other...
  description String?
  color       String   @default("#6366f1")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  documents   Document[]
  vendors     Vendor[]            @relation("ProjectVendors")
  memberships ProjectMembership[]
  requests    Request[]
  subProjects SubProject[]

  @@index([ownerId])
}

// Sub-projekt (etapa/složka) – hierarchické seskupení uvnitř projektu.
model SubProject {
  id          String    @id @default(cuid())
  projectId   String
  parentId    String?
  name        String
  description String?
  budget      Decimal?  @db.Decimal(12, 2)
  deadline    DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    SubProject?  @relation("SubTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  SubProject[] @relation("SubTree")
  createdBy User         @relation("SubProjectCreatedBy", fields: [createdById], references: [id])
  expenses  Expense[]
  requests  Request[]

  @@index([projectId])
  @@index([parentId])
}

// Přístup k projektu podle e-mailu + role (owner | active | reader).
// Vendor s rolí "vendor" (jen kontakt) zde záznam nemá.
model ProjectMembership {
  id        String   @id @default(cuid())
  projectId String
  email     String // identifikátor člena (lowercase)
  role      String   @default("active")
  vendorId  String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([email])
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("CZK")
  category    String   @default("other")
  kind        String   @default("expense") // expense | work | purchase
  status      String   @default("approved") // approved | for_approval
  hours       Decimal? @db.Decimal(10, 2)
  rate        Decimal? @db.Decimal(12, 2)
  date        DateTime @default(now())
  paid           Boolean   @default(false)
  dueDate        DateTime?
  variableSymbol String?
  vendorId    String?
  subProjectId String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  vendor     Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  subProject SubProject? @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  documents  Document[]

  @@index([projectId])
  @@index([date])
  @@index([vendorId])
  @@index([subProjectId])
}

model Document {
  id           String   @id @default(cuid())
  projectId    String
  expenseId    String?
  fileName     String // klíč v úložišti (storage key)
  originalName String
  mimeType     String
  size         Int
  type         String   @default("other") // receipt | invoice | contract | revision | insurance | other
  uploadedById String
  createdAt    DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expense    Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  uploadedBy User     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([expenseId])
}
