// DMS – datový model
// Dokumentace: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) tabulky
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // pro přihlášení e-mailem/heslem (Credentials)
  createdAt     DateTime  @default(now())
  // Fakturační údaje (faktura za vykázanou práci)
  billingName    String?
  billingIco     String?
  billingDic     String?
  billingAddress String?
  billingAccount String? // číslo účtu nebo IBAN
  vatPayer       Boolean   @default(false)
  remindersAt    DateTime? // kdy se naposledy generovaly připomínky
  notifications  Notification[]

  accounts          Account[]
  sessions          Session[]
  projects          Project[]  @relation("ProjectOwner")
  expensesCreated   Expense[]  @relation("ExpenseCreatedBy")
  incomesCreated    Income[]   @relation("IncomeCreatedBy")
  documentsUploaded Document[] @relation("DocumentUploadedBy")
  vendors           Vendor[]     @relation("VendorOwner")
  requestsCreated   Request[]    @relation("RequestCreatedBy")
  offersCreated     Offer[]      @relation("OfferCreatedBy")
  subProjectsCreated SubProject[] @relation("SubProjectCreatedBy")
  tasksCreated      Task[]       @relation("TaskCreatedBy")
  materials         Material[]   @relation("MaterialOwner")
  operations        Operation[]  @relation("OperationOwner")
  catalogWishes     CatalogWish[] @relation("CatalogWishOwner")
  packages          Package[]    @relation("PackageOwner")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Doménový model
// ---------------------------------------------------------------------------

// Evidence dodavatelů v rámci účtu. E-mail je identifikátor (unikátní na účet)
// a bude sloužit i pro budoucí přístup dodavatele k dedikovaným projektům.
model Vendor {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  email       String
  category    String   @default("other")
  phone       String?
  description String?
  ico         String?
  dic         String?
  address     String?
  hourlyRate  Decimal? @db.Decimal(12, 2)
  bankAccount String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User      @relation("VendorOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  expenses Expense[]
  projects Project[] @relation("ProjectVendors")
  requests Request[]
  offers   Offer[]
  tasks    Task[]
  availability VendorAvailability[]

  @@unique([ownerId, email])
  @@index([ownerId])
}

// Dostupnost dodavatele po dnech (kalendář). available=true: může pracovat.
model VendorAvailability {
  id        String   @id @default(cuid())
  vendorId  String
  date      DateTime @db.Date
  available Boolean  @default(true)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
  @@index([vendorId])
}

// Poptávka (procurement). Dodavatel může být prázdný – doplní se po výběru.
model Request {
  id           String    @id @default(cuid())
  projectId    String
  title        String
  description  String?
  quantity     Decimal?  @db.Decimal(12, 2)
  unit         String    @default("ks")
  category     String    @default("other")
  price        Decimal?  @db.Decimal(12, 2)
  vendorId     String?
  subProjectId String?
  taskId       String? // navázáno na úkol/fázi (procurement prerekvizita)
  startDate    DateTime? // začátek výběrového řízení
  requiredDate DateTime?
  leadDays     Int? // dodací lhůta ve dnech (objednat do = potřeba − leadDays)
  status       String    @default("poptavka") // poptavka | nabidka | vyhovuje | objednano | schvaleno | zruseno
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor     Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  subProject SubProject? @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("RequestCreatedBy", fields: [createdById], references: [id])
  offers     Offer[]
  documents  Document[] // e-maily a přílohy hlavičky žádanky (#32)
  expenses   Expense[] // realizované výdaje k této žádance

  comparisons OfferComparison[]
  @@index([projectId])
  @@index([vendorId])
  @@index([subProjectId])
  @@index([taskId])
}

// Nabídka k žádance (výběrové řízení). Dodavatel z evidence nebo volný název;
// cenu, termín a poznámku lze doplnit dodatečně. Vybraná předvyplní žádanku.
model Offer {
  id           String    @id @default(cuid())
  requestId    String
  vendorId     String?
  vendorName   String?
  price        Decimal?  @db.Decimal(12, 2)
  deliveryDate DateTime?
  note         String? // komentář / hodnocení nabídky
  rating       String? // hodnocení dodavatele (text)
  score        Int? // bodové hodnocení nabídky (pro řazení)
  status       String    @default("nova") // nova | vyhovuje | odmitnuta | vybrana
  selected     Boolean   @default(false)
  // Z vytěžení AI (#33): odkud nabídka je a jaké úkoly navrhnout do plánu po výběru.
  extractionId   String?
  extractionPart Int?
  planTasks      Json? // [{ title, days, kind: "order"|"wait"|"work" }]
  tasksCreatedAt DateTime? // úkoly už založené (po výběru nabídky)
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  request   Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor    Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy User       @relation("OfferCreatedBy", fields: [createdById], references: [id])
  documents Document[]
  expenses  Expense[] // realizované výdaje z vybrané nabídky

  @@index([requestId])
  @@index([vendorId])
}

// Editovatelný číselník stavů (vestavěné jsou v kódu). scope = request | offer.
model StatusOption {
  id        String   @id @default(cuid())
  scope     String
  key       String
  label     String
  color     String? // tailwind klíč barvy (např. "emerald", "amber") pro barevné rozlišení
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([scope, key])
}

// Sdílený číselník vlastních typů projektů (vestavěné typy jsou v kódu).
model ProjectType {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  icon      String   @default("folder")
  createdAt DateTime @default(now())
}

// Sdílený číselník vlastních kategorií výdajů (vestavěné jsou v kódu).
model ExpenseCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  createdAt DateTime @default(now())
}

// Sdílený číselník vlastních typů dokumentů (vestavěné jsou v kódu).
model DocumentType {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("other") // house, garage, car, other...
  description String?
  color       String   @default("#6366f1")
  defaultKind     String? // výchozí druh nového výdaje (expense | work)
  defaultCategory String? // výchozí kategorie
  defaultCurrency String? // výchozí měna
  // Termíny projektu: začátek, očekávané dokončení (plán) a skutečné dokončení.
  startDate   DateTime?
  plannedEnd  DateTime?
  actualEnd   DateTime?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  incomes     Income[]
  documents   Document[]
  vendors     Vendor[]            @relation("ProjectVendors")
  memberships ProjectMembership[]
  requests    Request[]
  subProjects SubProject[]
  tasks       Task[]

  planDrafts  PlanDraft[]
  invoices    Invoice[]
  @@index([ownerId])
}

// Sub-projekt (etapa/složka) – hierarchické seskupení uvnitř projektu.
model SubProject {
  id          String    @id @default(cuid())
  projectId   String
  parentId    String?
  name        String
  description String?
  budget      Decimal?  @db.Decimal(12, 2)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     SubProject?  @relation("SubTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   SubProject[] @relation("SubTree")
  createdBy  User         @relation("SubProjectCreatedBy", fields: [createdById], references: [id])
  expenses   Expense[]
  incomes    Income[]
  requests   Request[]
  tasks      Task[]
  memberships SubProjectMembership[]

  @@index([projectId])
  @@index([parentId])
}

// Úkol (plánování). Termíny a stav jsou na úkolu (ne na subprojektu).
model Task {
  id            String    @id @default(cuid())
  projectId     String
  subProjectId  String?
  parentId      String? // dílčí úkol patří pod fázi (Task kind=phase)
  kind          String    @default("task") // task | phase | todo (todo = mimo plánování, bez Ganttu a přepočtu termínů)
  title         String
  description   String?
  assigneeEmail String?
  startDate     DateTime?
  dueDate       DateTime?
  status        String    @default("todo") // editovatelný číselník scope "task"
  percentDone   Int       @default(0) // 0–100 % dokončení
  ready         Boolean   @default(true) // připraveno k práci (false = čeká na materiál, jiný úkol…)
  blockNote     String? // proč je blokováno (ruční blokace v plánování: povolení, počasí…)
  selfPerformed Boolean   @default(false) // svépomocí – dodavatel se nehledá
  priority      String? // high | medium | low (volitelné)
  profession    String? // řemeslo/profese (Projektant, Statik, Elektrikář…)
  estimateDays  Int? // odhad doby trvání ve dnech
  costEstimate  Decimal?  @db.Decimal(12, 2) // odhad nákladů (AI plán / ručně) – do forecastu, dokud ho nepokryje žádanka
  procurement   String? // co poptat u dodavatele (AI plán) – tlačítkem z toho vznikne žádanka
  actualStart   DateTime? // skutečný začátek (první rozdělání) – realita vs. odhad
  actualEnd     DateTime? // skutečný konec (dokončení)
  dateLocked    Boolean   @default(false) // termín zadán ručně → automatický přepočet ho nepřepíše
  operationId     String? // úkon katalogu, ze kterého úkol vznikl (proklik na recept)
  operationParams String? // JSON { values: {...}, multiplier } – zadané parametry (m²/m³, délka…)
  vendorId      String? // přiřazený dodavatel (lookup)
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subProject SubProject? @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  parent     Task?       @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Task[]      @relation("TaskTree")
  createdBy  User        @relation("TaskCreatedBy", fields: [createdById], references: [id])
  vendor     Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  // Závislosti mezi fázemi (kind=phase): "tato fáze navazuje na…".
  dependsOn   TaskDependency[] @relation("TaskDepFrom")
  dependedOnBy TaskDependency[] @relation("TaskDepTo")
  requests   Request[] // žádanky navázané na úkol/fázi (procurement)
  expenses   Expense[] // výdaje navázané na úkol/fázi

  @@index([projectId])
  @@index([subProjectId])
  @@index([parentId])
  @@index([vendorId])
}

// Vazba "fáze A navazuje na fázi B" (taskId závisí na dependsOnId).
// Používá se hlavně mezi fázemi (kind=phase) pro blokaci v plánování.
model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String

  task      Task @relation("TaskDepFrom", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDepTo", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
}

// Přístup dodavatele přímo k subprojektu (per-subprojekt). Platí i pro jeho
// vnořené pod-složky. Projektové členství (ProjectMembership) má přednost.
model SubProjectMembership {
  id           String   @id @default(cuid())
  subProjectId String
  projectId    String
  email        String
  role         String   @default("active")
  vendorId     String?
  createdAt    DateTime @default(now())

  subProject SubProject @relation(fields: [subProjectId], references: [id], onDelete: Cascade)

  @@unique([subProjectId, email])
  @@index([email])
  @@index([projectId])
}

// Přístup k projektu podle e-mailu + role (owner | active | reader).
// Vendor s rolí "vendor" (jen kontakt) zde záznam nemá.
model ProjectMembership {
  id        String   @id @default(cuid())
  projectId String
  email     String // identifikátor člena (lowercase)
  role      String   @default("active")
  vendorId  String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([email])
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("CZK")
  category    String   @default("other")
  kind        String   @default("expense") // expense | work | purchase
  status      String   @default("approved") // approved | for_approval (schvalování)
  stage       String? // uživatelský stav (životní cyklus) – číselník scope "expense"
  hours       Decimal? @db.Decimal(10, 2)
  rate        Decimal? @db.Decimal(12, 2)
  date        DateTime @default(now())
  dueDate        DateTime?
  variableSymbol String?
  exportedAt  DateTime? // označeno jako vyexportováno do CSV (účetnictví)
  vendorId    String?
  subProjectId String?
  taskId      String? // navázáno na úkol/fázi
  requestId   String? // realizace žádanky (výběrového řízení)
  offerId     String? // realizace konkrétní (vybrané) nabídky
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Daňový doklad: číslo, DUZP, rozpis DPH a dodavatel z ARESu (vytěžení dokladu)
  docNumber   String? // číslo dokladu / faktury
  taxDate     DateTime? // DUZP (datum uskutečnění zdanitelného plnění)
  vatBase     Decimal?  @db.Decimal(12, 2) // základ celkem
  vatAmount   Decimal?  @db.Decimal(12, 2) // daň celkem
  vatRate     Decimal?  @db.Decimal(5, 2) // hlavní sazba (0 / 12 / 21)
  vatBreakdown Json? // [{ rate, base, vat }] po sazbách
  supplierIco String?
  supplierDic String?
  deductible  Boolean @default(true) // brát do podkladu pro DPH
  items       ExpenseItem[]

  invoiceId  String? // faktura (žádost o úhradu), na které je výkaz
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  vendor     Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  subProject SubProject? @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  request    Request?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  offer      Offer?      @relation(fields: [offerId], references: [id], onDelete: SetNull)
  documents  Document[]

  @@index([projectId])
  @@index([projectId, date])
  @@index([date])
  @@index([stage])
  @@index([createdById])
  @@index([vendorId])
  @@index([subProjectId])
  @@index([taskId])
  @@index([requestId])
  @@index([offerId])
}

// Příjem (income) – peníze přicházející do projektu (dotace, vlastní vklad,
// prodej, refundace…). Saldo projektu = příjmy − výdaje. Záměrně jednodušší
// než Expense: bez dodavatele/žádanky/QR plateb/životního cyklu.
model Income {
  id           String   @id @default(cuid())
  projectId    String
  subProjectId String?
  title        String
  description  String?
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("CZK")
  category     String   @default("other") // dotace | vklad | prodej | refundace | other
  date         DateTime @default(now())
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subProject SubProject? @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("IncomeCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([subProjectId])
  @@index([date])
}

// Položka dokladu z vytěžení – podklad pro porovnání s ceníkem katalogu.
model ExpenseItem {
  id          String   @id @default(cuid())
  expenseId   String
  line        Int      @default(0)
  description String
  quantity    Decimal? @db.Decimal(12, 3)
  unit        String?
  unitPrice   Decimal? @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  vatRate     Decimal? @db.Decimal(5, 2)
  // porovnání s katalogem (materiál nebo úkon)
  materialCode String?
  catalogPrice Decimal? @db.Decimal(12, 2)
  diffPct      Decimal? @db.Decimal(7, 2) // +% nad ceníkem, −% pod ním
  createdAt   DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([materialCode])
}

// Vytěžení účtenky/faktury z přílohy (#doklady): návrh výdaje k potvrzení.
model DocScan {
  id          String   @id @default(cuid())
  projectId   String
  documentId  String   @unique
  status      String   @default("running") // running | ready | error | applied | dismissed
  result      Json?
  error       String?
  model       String
  costUsd     Float?
  expenseId   String? // vzniklý výdaj (po potvrzení)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model Document {
  id           String   @id @default(cuid())
  projectId    String
  expenseId    String?
  offerId      String?
  requestId    String? // příloha hlavičky žádanky – e-mail, nabídka v PDF (#32)
  summary      String? // u e-mailu "Od · Předmět", ať je vidět bez otevírání
  note         String? // poznámka uživatele – např. změny oproti dokumentaci (AI ji bere v potaz)
  fileName     String // klíč v úložišti (storage key)
  originalName String
  mimeType     String
  size         Int
  type         String   @default("other") // receipt | invoice | contract | revision | insurance | other
  uploadedById String
  createdAt    DateTime @default(now())
  exportedAt   DateTime? // označeno jako stažené/vyexportováno (hromadné stažení příloh)

  extractions Extraction[]
  scan       DocScan?
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expense    Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  offer      Offer?   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  request    Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([expenseId])
  @@index([offerId])
  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Procesní tabulky – katalog materiálů, úkonů a receptů. Počítá množství, cenu
// a pracnost (normohodiny); neřeší harmonogram. Vše v rámci účtu (ownerId).
// ---------------------------------------------------------------------------

// Číselník stavebních materiálů s aktuální cenou (typicky z ceníku DEK ap.).
model Material {
  id          String    @id @default(cuid())
  ownerId     String
  code        String // klíč pro reimport ceníku (aktualizace ceny dle kódu)
  name        String
  unit        String    @default("ks") // MJ: ks, kg, m, m2, m3, pytel, l…
  unitPrice   Decimal   @default(0) @db.Decimal(12, 2)
  priceSource String? // odkud cena (např. "DEK 2026-06")
  priceDate   DateTime?
  category    String    @default("other")
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner   User                @relation("MaterialOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipes OperationMaterial[]

  @@unique([code])
  @@index([ownerId])
}

// Číselník stavebních úkonů/procesů (např. vyzdění příčky, betonáž základů).
// quantityFormula = množství v MJ úkonu, laborFormula = normohodiny – obojí
// vzorec nad parametry úkonu (viz src/lib/formula.ts).
model Operation {
  id              String   @id @default(cuid())
  ownerId         String
  code            String
  name            String
  unit            String   @default("m2") // MJ úkonu (m2, bm, m3, ks…)
  quantityFormula String   @default("1") // množství MJ z parametrů
  laborFormula    String   @default("0") // normohodiny z parametrů
  laborRate       Decimal? @db.Decimal(12, 2) // hodinová sazba práce (Kč/Nh)
  crew            Int      @default(1) // počet lidí v partě → dny = normohodiny / (8 × crew)
  techPauseDays   Int? // technologická pauza po činnosti (zrání/tvrdnutí, dny)
  description     String?
  category        String   @default("other")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner        User                @relation("OperationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  params       OperationParam[]
  materials    OperationMaterial[]
  packageItems PackageItem[]

  @@unique([code])
  @@index([ownerId])
}

// Parametr úkonu (vstup pro vzorce), např. delka, vyska, vyska_rady.
model OperationParam {
  id           String   @id @default(cuid())
  operationId  String
  key          String // identifikátor použitý ve vzorcích (bez diakritiky)
  label        String
  unit         String?
  defaultValue Decimal? @db.Decimal(12, 4)
  sort         Int      @default(0)

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, key])
  @@index([operationId])
}

// Řádek receptu: spotřeba materiálu na úkon dle vzorce (+ prořez %).
model OperationMaterial {
  id              String   @id @default(cuid())
  operationId     String
  materialId      String
  quantityFormula String   @default("0") // spotřeba z parametrů úkonu
  wastePct        Decimal? @db.Decimal(6, 2)
  note            String?

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  material  Material  @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([operationId])
  @@index([materialId])
}

// Balíček procesů „na klíč" – pojmenovaná sestava úkonů (sdílený katalog).
model Package {
  id        String   @id @default(cuid())
  ownerId   String
  code      String
  name      String
  unit      String   @default("m2")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User          @relation("PackageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items PackageItem[]

  @@unique([code])
  @@index([ownerId])
}

// Položka balíčku: úkon a jeho množství na 1 MJ balíčku.
model PackageItem {
  id          String   @id @default(cuid())
  packageId   String
  operationId String
  qtyPerUnit  Decimal  @default(1) @db.Decimal(12, 4)
  note        String?

  package   Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([operationId])
}

// Poznámka o chybějící činnosti/úkonu v katalogu (wishlist k doplnění přes AI).
model CatalogWish {
  id        String   @id @default(cuid())
  ownerId   String
  title     String
  note      String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  owner User @relation("CatalogWishOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// Vytěžení nabídky přes AI (#33): návrh dodavatele a nabídek z přílohy žádanky.
// Nic se nezakládá samo – návrh čeká na potvrzení (status pending → applied/dismissed).
model Extraction {
  id           String   @id @default(cuid())
  projectId    String
  requestId    String // žádanka, u které příloha leží
  documentId   String
  status       String   @default("running") // running | ready | info | error | partial | applied | dismissed
  instructions String? // pokyn uživatele pro AI (volitelný)
  appliedParts Int[]    @default([]) // indexy částí, ze kterých už je nabídka
  result       Json?
  error        String?
  model        String
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([documentId])
  @@index([createdAt])
}

// AI porovnání nabídek u žádanky – stručný report pro výběr podle pokynu.
model OfferComparison {
  id          String   @id @default(cuid())
  requestId   String
  prompt      String?
  status      String   @default("running") // running | ready | error
  result      Json?
  error       String?
  model       String
  costUsd     Float?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([createdAt])
}

// AI plán projektu z dokumentace (#34): návrh fází a úkolů s odhady podle katalogu.
model PlanDraft {
  id          String   @id @default(cuid())
  projectId   String
  kind        String   @default("plan") // plan = plán z dokumentace | costs = odhad nákladů stávajícího plánu
  replaceExisting Boolean @default(false) // nahradit dříve navržený (nezačatý) plán
  status      String   @default("running") // running | ready | error | applied | dismissed
  prompt      String?
  documentIds String[]
  result      Json?
  error       String?
  model       String
  costUsd     Float?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

// Záznam útraty za AI – bez vazeb, aby se se smazaným projektem neztratil
// (limity počítají z něj, jinak by smazání projektu „vynulovalo“ útratu).
model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String?
  kind      String // extraction | comparison | plan
  model     String
  costUsd   Float
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Oznámení (zvoneček): přidělené úkoly, výdaje od ostatních, připomínky, úhrady.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // task_assigned | expense_added | reminder | invoice_requested | invoice_paid
  title     String
  body      String?
  href      String?
  projectId String?
  dedupeKey String? // připomínky se stejným klíčem se nezakládají znovu
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

// Faktura / žádost o úhradu vykázané práce (dodavatel → vlastník projektu).
model Invoice {
  id          String    @id @default(cuid())
  number      String // např. 2026-0001 (řada vystavovatele)
  kind        String    @default("invoice") // invoice = faktura | request = žádost o úhradu (bez živnosti)
  projectId   String
  issuerId    String // dodavatel (vystavil)
  recipientId String // vlastník projektu (platí)
  status      String    @default("requested") // requested | paid | cancelled
  issueDate   DateTime  @default(now())
  dueDate     DateTime
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("CZK")
  vs          String // variabilní symbol
  supplier    Json // snímek fakturačních údajů dodavatele
  customer    Json // snímek údajů odběratele
  note        String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([issuerId, number])
  @@index([projectId])
  @@index([recipientId, status])
}
